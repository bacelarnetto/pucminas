pipeline{
    agent any
    stages{
        stage("Build Back-end Java"){
            steps{
                echo "Build!!! compilando o projeto e gerando as imagens no docker"
                sh "cd sica-microservices-java && mvn clean install -Dmaven.test.skip=true"
            }
        }
         stage("Unit Tests Back-end Java"){
            steps{
                echo "Teste!!! executando os testes unitarios"
                sh "cd sica-microservices-java && mvn test"
            }
        }
        stage("Deploy Back-end Java"){
            steps{
                echo ">>> Deploy!!!"
                sh "cd sica-microservices-java && docker-compose up -d --build"
            }
        }
    }   
}
